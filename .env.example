# Copy to .env for local development. All vars are prefixed RT_ to match
# Settings(env_prefix="RT_") in src/rt_collab/config.py.

RT_ENVIRONMENT=development
RT_LOG_LEVEL=INFO

# Leave unset to auto-generate a random instance id at process start.
# Set explicitly when running multiple gateway instances locally so logs are
# easy to tell apart.
# RT_INSTANCE_ID=gateway-a

RT_REDIS_URL=redis://localhost:6379/0

RT_MYSQL_HOST=localhost
RT_MYSQL_PORT=3306
RT_MYSQL_USER=rt_collab
RT_MYSQL_PASSWORD=rt_collab
RT_MYSQL_DATABASE=rt_collab

# Dev-only default. Real deployments must override this.
RT_AUTH_SECRET=dev-secret-change-me
